Drop-in Website Helper (webAdminSessionSync.js)
Add this file to your website project (compatible with Firebase JS SDK v9+ modular) and call startWebAdminSession(auth, app, user) right after an admin signs in, and endWebAdminSession(app, user) when they click Sign Out:
JavaScript
import {
  getFirestore,
  doc,
  getDoc,
  setDoc,
  updateDoc,
  onSnapshot,
  serverTimestamp,
} from "firebase/firestore";
import { signOut } from "firebase/auth";

const FIRESTORE_DB_ID = "ai-studio-alifcarportal-c5b73261-7322-4966-b5e2-59c51963e99b";
const DEVICE_ID_KEY = "alif_web_admin_device_id";

let unsubscribeSessionWatch = null;

function sanitizeId(value) {
  return String(value || "").replace(/[^a-zA-Z0-9_-]/g, "");
}

function getOrCreateWebDeviceId() {
  let id = localStorage.getItem(DEVICE_ID_KEY);
  if (!id) {
    id = (crypto?.randomUUID?.() || `${Date.now()}_${Math.random().toString(36).slice(2)}`).replace(/-/g, "");
    localStorage.setItem(DEVICE_ID_KEY, id);
  }
  return id;
}

function getSessionId(uid) {
  const cleanUid = sanitizeId(uid).slice(0, 10) || "admin";
  const cleanDev = sanitizeId(getOrCreateWebDeviceId()).slice(0, 12) || "browser";
  return `web_${cleanUid}_${cleanDev}`;
}

function detectBrowserDeviceName() {
  const ua = navigator.userAgent || "";
  const browser = /Edg\//.test(ua)
    ? "Edge"
    : /Chrome\//.test(ua)
    ? "Chrome"
    : /Safari\//.test(ua) && !/Chrome\//.test(ua)
    ? "Safari"
    : /Firefox\//.test(ua)
    ? "Firefox"
    : "Web Browser";

  const os = /Android/i.test(ua)
    ? "Android"
    : /iPhone|iPad|iPod/i.test(ua)
    ? "iOS"
    : /Windows/i.test(ua)
    ? "Windows"
    : /Mac OS X/i.test(ua)
    ? "macOS"
    : /Linux/i.test(ua)
    ? "Linux"
    : "Web";

  return `${browser} on ${os}`.slice(0, 160);
}

function getFallbackLocation() {
  try {
    const tz = Intl.DateTimeFormat().resolvedOptions().timeZone || "Web";
    return tz.replace(/_/g, " ").slice(0, 160);
  } catch {
    return "Website";
  }
}

/**
 * Call this inside onAuthStateChanged when an authorized admin signs in on the website.
 * Note: The admin's Firebase Auth account must have a verified email to pass Firestore rules.
 */
export async function startWebAdminSession(auth, firebaseApp, user) {
  if (!user || !user.emailVerified) return;

  const db = getFirestore(firebaseApp, FIRESTORE_DB_ID);
  const sessionId = getSessionId(user.uid);
  const deviceId = getOrCreateWebDeviceId().slice(0, 128);
  const deviceName = detectBrowserDeviceName();
  const email = (user.email || "").trim().slice(0, 254);
  const location = getFallbackLocation();
  const userAgent = (navigator.userAgent || "").slice(0, 300);
  const now = Date.now();

  const sessionRef = doc(db, "adminSessions", sessionId);
  const existingSnap = await getDoc(sessionRef);

  if (!existingSnap.exists()) {
    await setDoc(sessionRef, {
      id: sessionId,
      uid: user.uid.slice(0, 128),
      deviceId,
      deviceName,
      platform: "Website",
      email,
      location,
      loginAtMillis: now,
      lastActiveMillis: now,
      status: "active",
      userAgent,
      createdAt: serverTimestamp(),
      updatedAt: serverTimestamp(),
    });
  } else {
    await updateDoc(sessionRef, {
      deviceName,
      platform: "Website",
      email,
      location,
      loginAtMillis: now,
      lastActiveMillis: now,
      status: "active",
      userAgent,
      updatedAt: serverTimestamp(),
    });
  }

  // Create a login alert once per browser tab login so the Android app sends a notification
  const alertFlagKey = `alif_web_alert_sent_${user.uid}_${user.metadata?.lastSignInTime || ""}`;
  if (!sessionStorage.getItem(alertFlagKey)) {
    const alertId = `alert_web_${sanitizeId(crypto?.randomUUID?.() || `${now}`).slice(0, 16)}`;
    await setDoc(doc(db, "loginAlerts", alertId), {
      id: alertId,
      sessionId,
      uid: user.uid.slice(0, 128),
      email,
      deviceName,
      platform: "Website",
      location,
      timestampMillis: now,
      decision: "pending",
      createdAt: serverTimestamp(),
      updatedAt: serverTimestamp(),
    });
    sessionStorage.setItem(alertFlagKey, "1");
  }

  // Live remote sign-out: if revoked from the Android app, sign out this browser immediately
  if (unsubscribeSessionWatch) unsubscribeSessionWatch();
  unsubscribeSessionWatch = onSnapshot(sessionRef, (snap) => {
    if (snap.exists() && snap.data()?.status === "revoked") {
      stopWebSessionWatcher();
      signOut(auth);
    }
  });
}

/**
 * Call this right before calling signOut(auth) on the website admin logout button.
 */
export async function endWebAdminSession(firebaseApp, user) {
  stopWebSessionWatcher();
  if (!user) return;
  try {
    const db = getFirestore(firebaseApp, FIRESTORE_DB_ID);
    const sessionId = getSessionId(user.uid);
    await updateDoc(doc(db, "adminSessions", sessionId), {
      status: "revoked",
      updatedAt: serverTimestamp(),
    });
  } catch (err) {
    console.warn("Unable to mark website admin session revoked:", err);
  }
}

export function stopWebSessionWatcher() {
  if (unsubscribeSessionWatch) {
    unsubscribeSessionWatch();
    unsubscribeSessionWatch = null;
  }
}
